// This is your Prisma schema file,
/*(If you aren't tracking migrations via Git folders for this specific project iteration, you can run pnpm prisma db push followed by pnpm prisma generate instead).*/
// learn more about it in the docs: https://pris.ly/d/prisma-schema
//npx @better-auth/cli generate is used to generate schema based on the lib>auth file
// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
    provider = "prisma-client"
    output   = "../src/generated/prisma"
}

datasource db {
    provider = "postgresql"
}

enum OrderStatus {
    PENDING
    PAID
    ASSIGNED
    PICKED_UP
    DELIVERY_COMPLETED
    CANCELLED
}

enum SourcingType {
    OPEN_MARKET
    SUPERMARKET
}

enum StockStatus {
    IN_STOCK
    OUT_OF_STOCK
}

enum RiderStatus {
    AVAILABLE
    ON_DELIVERY
    ON_BREAK
    OFFLINE
}

enum NotificationType {
    ORDER_PLACED
    ORDER_ASSIGNED
    ORDER_PICKED_UP
    ORDER_DELIVERED
    ORDER_CANCELLED
}

model Hub {
    id        String             @id @default(uuid())
    name      String             @unique
    slug      String             @unique
    isActive  Boolean            @default(true)
    products  HubProductConfig[]
    orders    Order[]
    latitude  Float              @default(0.0)
    longitude Float              @default(0.0)
    hubFees   HubDeliveryFee[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("hubs")
}

model HubDeliveryFee {
    id          String  @id @default(uuid())
    addressId   String
    hubId       String
    distanceKm  Float
    deliveryFee Decimal @db.Decimal(10, 2)

    // Relations
    address SavedAddress @relation(fields: [addressId], references: [id], onDelete: Cascade)
    hub     Hub          @relation(fields: [hubId], references: [id], onDelete: Cascade)

    @@unique([addressId, hubId]) // Ensures one clean calculation per unique pair
    @@map("hub_delivery_fees")
}

model Product {
    id           String             @id @default(uuid())
    sku          String?            @unique // Bard code for supermarket items
    name         String
    category     String //"FreshProduce Pantry
    sourcingType SourcingType
    image        String?
    quantityText String?
    isSeasonal   Boolean            @default(false)
    isOrganic    Boolean            @default(true)
    basePrice    Decimal            @db.Decimal(10, 2)
    hubConfigs   HubProductConfig[]
    orderItems   OrderItem[]
    createdAt    DateTime           @default(now())
    updatedAt    DateTime           @updatedAt
    isDeleted    Boolean            @default(false)

    @@map("products")
}

model HubProductConfig {
    id        String @id @default(uuid())
    hubId     String
    productId String
    // Supermarket items: Flipped manually via admin panel based on daily call updates
    // Open Market items: Typically stays IN_STOCK unless a total seasonal wipeout happens

    status     StockStatus @default(IN_STOCK)
    //price adjustments per hub (Juja market kales might cost less than a remote hub)
    localPrice Decimal     @db.Decimal(10, 2)

    hub          Hub        @relation(fields: [hubId], references: [id], onDelete: Cascade)
    product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
    priceHistory PriceLog[]

    @@unique([hubId, productId])
    @@map("hub_product_configs")
}

//Keeps an audit trail of open market price fluctuations for analytics
model PriceLog {
    id                 String           @id @default(uuid())
    hubProductConfigId String
    oldPrice           Decimal          @db.Decimal(10, 2)
    newPrice           Decimal          @db.Decimal(10, 2)
    changedById        String? //Admin who noted the market updated
    createdAt          DateTime         @default(now())
    config             HubProductConfig @relation(fields: [hubProductConfigId], references: [id], onDelete: Cascade)

    @@map("price_logs")
}

model Order {
    id        String @id @default(uuid())
    userId    String
    reference String @unique

    courierTelegramId   String?
    courierName         String?
    deliveryPin         String         @default("0000")
    //two-tier address setup
    destinationLabel    String?
    deliveryDestination String
    apartmentName       String
    houseNumber         String
    landmark            String?
    customerLatitude    Float
    customerLongitude   Float
    notifications       Notification[]

    // Financial Breakdown

    subtotal    Decimal     @db.Decimal(10, 2)
    serviceFee  Decimal     @db.Decimal(10, 2)
    deliveryFee Decimal     @db.Decimal(10, 2) //distance based dynamic fee
    totalAmount Decimal     @db.Decimal(10, 2)
    status      OrderStatus @default(PENDING)

    completedAt DateTime @default(now())
    createdAt   DateTime @default(now())
    updatedAt   DateTime @updatedAt

    //relations
    items    OrderItem[]
    payments PaymentTransaction[]
    hubs     Hub[]
    riderId  String?
    rider    Rider?               @relation(fields: [riderId], references: [id], onDelete: SetNull)

    @@map("orders")
}

model OrderItem {
    id              String  @id @default(uuid())
    orderId         String
    productId       String
    order           Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
    product         Product @relation(fields: [productId], references: [id])
    isAvailable     Boolean @default(true)
    productName     String
    quantity        Int
    priceAtPurchase Decimal @db.Decimal(10, 2)

    // totalAmount       Decimal @db.Decimal(10,2)
    @@map("order_items")
}

model Rider {
    id           String  @id @default(uuid())
    name         String
    phone        String  @unique
    telegramId   String? @unique
    vehiclePlate String
    vehicleType  String? // e.g. "MOTORBIKE", "BICYCLE"

    dispatchHub String?
    status      RiderStatus @default(AVAILABLE)
    rating      Float       @default(5.0)

    isDeleted Boolean   @default(false)
    deletedAt DateTime?

    // Optional: Link to a User account if riders log in via your web/mobile app
    userId String? @unique
    user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Relation: One rider can be assigned to many orders over time
    orders Order[]

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([telegramId])
    @@index([isDeleted])
    @@map("riders")
}

model PaymentTransaction {
    id                String    @id @default(uuid())
    amount            Decimal   @db.Decimal(10, 2)
    idempotencyKey    String?   @unique
    status            String    @default("QUEUED")
    reference         String    @unique
    checkoutRequestId String?
    webhookReceived   Boolean   @default(false)
    createdAt         DateTime  @default(now())
    completedAt       DateTime? @default(now())
    order             Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
    orderId           String
    userId            String
    user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("payment_transactions")
}

model Account {
    id                    String    @id @default(cuid())
    userId                String    @map("user_id")
    user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
    accountId             String
    providerId            String
    accessToken           String?
    refreshToken          String?
    idToken               String?
    accessTokenExpiresAt  DateTime?
    refreshTokenExpiresAt DateTime?
    password              String?
    createdAt             DateTime  @default(now())
    updatedAt             DateTime  @updatedAt

    @@index([userId])
    @@map("accounts")
}

model Session {
    id     String @id @default(cuid())
    userId String @map("user_id")

    expiresAt DateTime // Better Auth uses expiresAt, not expires
    token     String   @unique // Better Auth tracks unique session tokens
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt
    ipAddress String?
    userAgent String?

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@map("sessions")
}

model User {
    id            String               @id @default(cuid())
    name          String?
    email         String?              @unique
    emailVerified Boolean              @default(false)
    image         String?
    accounts      Account[]
    sessions      Session[]
    transactions  PaymentTransaction[]
    rider         Rider[]
    addresses     SavedAddress[] // One-to-many relation
    createdAt     DateTime             @default(now())
    updatedAt     DateTime             @updatedAt

    role          String?        @default("user") // Can be "user" or "admin"
    banned        Boolean?       @default(false)
    banReason     String?
    banExpires    DateTime?
    notifications Notification[]

    twoFactorEnabled     Boolean?    @default(false)
    twoFactorSecret      String?
    twoFactorBackupCodes String?
    twoFactor            TwoFactor[]

    @@map("users")
}

model Notification {
    id        String           @id @default(uuid())
    userId    String
    user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
    orderId   String?
    order     Order?           @relation(fields: [orderId], references: [id], onDelete: SetNull)
    title     String
    message   String
    type      NotificationType
    isRead    Boolean          @default(false)
    createdAt DateTime         @default(now())

    @@index([userId])
    @@map("notifications")
}

model TwoFactor {
    id          String  @id @default(cuid())
    secret      String
    backupCodes String
    userId      String
    verified    Boolean @default(false)
    user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("twoFactor")
}

model SavedAddress {
    id               String  @id @default(uuid())
    userId           String
    destinationLabel String? //  e.g., "Juja Home", "Nairobi Office", "Mom's Place"

    deliveryDestination String // General area/street address
    apartmentName       String
    houseNumber         String
    landmark            String?
    customerLatitude    Float
    customerLongitude   Float
    hubFees             HubDeliveryFee[]
    isDefault           Boolean          @default(false) // Automatically select this at checkout

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    // Relations
    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@map("saved_addresses")
}

model VerificationToken {
    identifier String
    token      String
    expires    DateTime

    @@unique([identifier, token])
    @@map("verification_tokens")
}

model Verification {
    id         String   @id
    identifier String
    value      String
    expiresAt  DateTime
    createdAt  DateTime @default(now())
    updatedAt  DateTime @updatedAt

    @@index([identifier])
    @@map("verification")
}
